    <rdf:Description rdf:about="">
      <dc:format>application/pdf</dc:format>
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Datasheet - STM32F405xx STM32F407xx - Arm&lt;Sup&gt;Â®&lt;/Sup&gt; Cortex&lt;Sup&gt;Â®&lt;/Sup&gt;-M4 32b MCU+FPU, 210DMIPS, up to 1MB flash/192+4KB RAM, USB OTG HS/FS, Ethernet, 17 TIMs, 3 ADCs, 15 comm. interfaces, and camera</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The STM32F405xx and STM32F407xx family is based on the high-performance ArmÂ® CortexÂ®-M4 32-bit RISC core operating at a frequency of up to 168 MHz. The CortexÂ®-M4 core features a floating-point unit (FPU) single precision which supports all Arm single-precision data-processing instructions and data types. It also implements a full set of DSP instructions and a memory protection unit (MPU) which enhances application security.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>STMICROELECTRONICS</rdf:li>
        </rdf:Seq>
